{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Mickdownunder/safeinstall",
  "description": "Local-first npm ecosystem policy checks: typosquat, release age, provenance checks",
  "repository": {
    "url": "https://github.com/Mickdownunder/SafeInstall",
    "source": "github"
  },
  "version": "0.15.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "safeinstall-cli",
      "version": "0.15.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
